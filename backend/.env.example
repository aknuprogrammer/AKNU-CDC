# AKNU CDC Backend Environment Variables
NODE_ENV=development
PORT=4000

# PostgreSQL Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aknu_cdc?schema=public"

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_ACCESS_SECRET=aknu_cdc_jwt_access_super_secret_key_2026_aknu
JWT_REFRESH_SECRET=aknu_cdc_jwt_refresh_super_secret_key_2026_aknu
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# DLT SMS Provider & Email Settings
SMS_API_KEY=mock_dlt_sms_api_key_aknu
SMS_SENDER_ID=AKNURJ
DLT_PE_ID=1201159123456789012
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=cdc@aknu.edu.in
SMTP_PASS=mock_smtp_password
SMTP_FROM="AKNU CDC Affiliations <cdc@aknu.edu.in>"

# Payment Gateways (SBI Collect / Razorpay)
PAYMENT_GATEWAY=mock
RAZORPAY_KEY_ID=rzp_test_mock_key_id
RAZORPAY_KEY_SECRET=rzp_test_mock_secret
RAZORPAY_WEBHOOK_SECRET=rzp_mock_webhook_secret_signature
SBI_COLLECT_MERCHANT_ID=AKNU_COLLECT_01
SBI_COLLECT_CHECKSUM_KEY=mock_sbi_checksum_key

# University Info
UNIVERSITY_NAME="Adikavi Nannaya University"
UNIVERSITY_SHORT="AKNU"
UNIVERSITY_CAMPUS="Rajamahendravaram - 533296, Andhra Pradesh"
